#!/usr/bin/env bash
set -euo pipefail

name=chimera
server_type=cpx11
location=hil
base_image=ubuntu-24.04
image_label=chimera=base
ssh_key=laptop
primary_ip=chimera-ip
firewall=chimera-firewall
volume=chimera-home
user=andre
cloud_init="$(dirname "$0")/../cloud-init.yaml"
image_init="$(dirname "$0")/../image.yaml"

server_status() {
  hcloud server list -o json | jq -r --arg n "$name" '(. // [])[] | select(.name == $n) | .status'
}

ssh_answers() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$user@$name" true 2>/dev/null
}

cmd_status() {
  local status
  status=$(server_status)
  if [ -n "$status" ] && ! hcloud server describe "$name" -o json | jq -e '.public_net.firewalls | length > 0' >/dev/null; then
    echo "Warning: public SSH is open. Close it with: hcloud firewall apply-to-resource $firewall --type server --server $name" >&2
  fi
  case "$status" in
    "") echo asleep ;;
    running) if ssh_answers; then echo awake; else echo waking; fi ;;
    initializing|starting) echo waking ;;
    stopping|off|deleting) echo going-to-sleep ;;
    *) echo "unknown ($status)" ;;
  esac
}

cmd_sleep() {
  local status
  status=$(server_status)
  if [ "$status" = running ]; then
    hcloud server shutdown "$name"
    echo "Backing up before sleep..."
  fi
  for _ in $(seq 360); do
    status=$(server_status)
    case "$status" in
      "") echo asleep; return ;;
      off) hcloud server delete "$name" || true ;;
    esac
    sleep 2
  done
  echo "The server didn't shut down within 12 minutes. Run 'chimera sleep' again, or force it off with 'hcloud server poweroff $name'." >&2
  exit 1
}

newest_image() {
  hcloud image list --type snapshot --selector "$image_label" --sort created:desc -o json | jq -r '(. // [])[0].id // empty'
}

create_server() {
  local image
  image=$(newest_image)
  [ -n "$image" ] || { echo "There's no chimera image yet. Build one with 'chimera build-image'." >&2; exit 1; }
  hcloud server create --name "$name" --type "$server_type" --image "$image" \
    --location "$location" --ssh-key "$ssh_key" --primary-ipv4 "$primary_ip" \
    --volume "$volume" --user-data-from-file "$@"
}

cmd_wake() {
  local status
  status=$(server_status)
  if [ "$status" = off ]; then
    hcloud server delete "$name" || true
    status=$(server_status)
  fi
  case "$status" in
    "")
      create_server "$cloud_init" --firewall "$firewall"
      ;;
    stopping|deleting)
      echo "The computer is still going to sleep. Run 'chimera wake' again in a minute." >&2
      exit 1
      ;;
  esac
  echo "Waiting for SSH on $name over Tailscale..."
  for _ in $(seq 60); do
    if ssh_answers; then echo awake; return; fi
    sleep 3
  done
  echo "SSH didn't answer within 3 minutes. Run 'ssh $user@$name' to see the error." >&2
  exit 1
}

push_backup_keys() {
  local config=~/.config/chimera dir=/home/.chimera/backup
  "$@" "sudo install -d -m 700 $dir && sudo sh -c 'umask 077 && cat > $dir/env'" < "$config/backup.env"
  "$@" "sudo sh -c 'umask 077 && cat > $dir/password'" < "$config/backup-password"
  "$@" "sudo chimera-restic cat config >/dev/null 2>&1 || sudo chimera-restic init"
}

cmd_backup_keys() {
  push_backup_keys ssh "$user@$name"
  echo "backup keys are on the volume"
}

close_public_ssh() {
  echo "Closing public SSH..."
  hcloud firewall apply-to-resource "$firewall" --type server --server "$name" >/dev/null && return
  echo "PUBLIC SSH IS STILL OPEN. Close it with: hcloud firewall apply-to-resource $firewall --type server --server $name" >&2
  return 1
}

cmd_restore() {
  [ -z "$(server_status)" ] || { echo "Put the computer to sleep first with 'chimera sleep'. Restore wakes it itself." >&2; exit 1; }
  tmp=$(mktemp -d)
  trap 'close_public_ssh; rm -rf "$tmp"' EXIT

  # A throwaway host key, given to the new server, lets us check we're talking to it before sending secrets.
  ssh-keygen -q -t ed25519 -N '' -C chimera-restore -f "$tmp/host"
  {
    cat "$cloud_init"
    echo "ssh_keys:"
    echo "  ed25519_private: |"
    sed 's/^/    /' "$tmp/host"
    echo "  ed25519_public: $(cat "$tmp/host.pub")"
  } > "$tmp/user-data"

  echo "Waking with public SSH open..."
  create_server "$tmp/user-data"
  local ip
  ip=$(hcloud server ip "$name")
  echo "$ip $(cut -d' ' -f1,2 "$tmp/host.pub")" > "$tmp/known_hosts"
  local public=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes
    -o UserKnownHostsFile="$tmp/known_hosts" -o HostKeyAlgorithms=ssh-ed25519 "$user@$ip")
  for _ in $(seq 60); do "${public[@]}" true 2>/dev/null && break; sleep 3; done
  "${public[@]}" "cloud-init status --wait >/dev/null" || { echo "Couldn't reach the computer at $ip, or its setup failed." >&2; exit 1; }

  if "${public[@]}" "test -e /home/.chimera/backup/env || tailscale status >/dev/null 2>&1"; then
    echo "This disk isn't blank (it has backup keys or a Tailscale login). Not restoring over it." >&2
    trap 'rm -rf "$tmp"' EXIT
    close_public_ssh || true
    cmd_sleep
    exit 1
  fi

  echo "Copying backup keys..."
  push_backup_keys "${public[@]}"
  echo "Restoring /home from the latest backup..."
  "${public[@]}" "sudo systemctl stop docker.socket docker containerd tailscaled && sudo chimera-restic restore latest --target / --exclude /home/.chimera/docker/volumes/backingFsBlockDev"
  echo "Restarting so it picks up its old Tailscale login and SSH fingerprint..."
  "${public[@]}" "sudo systemctl reboot" || true
  sleep 15

  trap 'rm -rf "$tmp"' EXIT
  close_public_ssh || exit 1
  echo "Waiting for $user@$name over Tailscale..."
  for _ in $(seq 60); do
    if ssh_answers; then echo "restored"; return; fi
    sleep 5
  done
  echo "The computer didn't come back over Tailscale within 5 minutes. Run 'ssh $user@$name' to see the error." >&2
  exit 1
}

cmd_build_image() {
  local build=chimera-image-build ip
  trap "hcloud server delete $build >/dev/null 2>&1 || echo 'Delete the build server with: hcloud server delete $build' >&2" EXIT
  echo "Building a fresh server to install everything on..."
  hcloud server create --name "$build" --type "$server_type" --image "$base_image" \
    --location "$location" --ssh-key "$ssh_key" --user-data-from-file "$image_init" >/dev/null
  ip=$(hcloud server ip "$build")
  # Nothing secret is sent, so a fresh server's unknown host key is accepted.
  local remote=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no
    -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "root@$ip")
  for _ in $(seq 60); do "${remote[@]}" true 2>/dev/null && break; sleep 3; done
  echo "Installing Tailscale, Docker, restic and updates..."
  if ! "${remote[@]}" "cloud-init status --wait >/dev/null"; then
    "${remote[@]}" "tail -30 /var/log/cloud-init-output.log" >&2 || true
    echo "Installing failed. Not saving an image." >&2
    exit 1
  fi
  echo "Wiping what makes it one particular machine..."
  "${remote[@]}" "systemctl stop tailscaled docker docker.socket containerd \
    && rm -rf /var/lib/tailscale/* /var/lib/docker/* /var/lib/containerd/* /etc/ssh/ssh_host_* \
    && cloud-init clean --logs --machine-id && sync && systemctl poweroff --no-block"
  for _ in $(seq 60); do [ "$(hcloud server describe "$build" -o json | jq -r .status)" = off ] && break; sleep 2; done
  [ "$(hcloud server describe "$build" -o json | jq -r .status)" = off ] || { echo "The build server didn't power off. Not saving an image." >&2; exit 1; }
  echo "Saving the image..."
  hcloud server create-image "$build" --type snapshot --label "$image_label" --description "chimera $(date -u +%F)"
  local old
  for old in $(hcloud image list --type snapshot --selector "$image_label" --sort created:desc -o json | jq -r '.[2:][].id'); do
    hcloud image delete "$old"
  done
  echo "Image ready. The next wake uses it."
}

case "${1:-}" in
  sleep) cmd_sleep ;;
  wake) cmd_wake ;;
  status) cmd_status ;;
  backup-keys) cmd_backup_keys ;;
  restore) cmd_restore ;;
  build-image) cmd_build_image ;;
  *) echo "usage: chimera sleep|wake|status|backup-keys|restore|build-image" >&2; exit 2 ;;
esac
