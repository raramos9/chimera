#!/usr/bin/env bash
set -euo pipefail

name=chimera
server_type=cpx11
location=hil
base_image=ubuntu-24.04
image_label=chimera=base
ssh_key=laptop
primary_ip=chimera-ip
firewall=chimera-firewall
volumes=(chimera-home chimera-machines)
user=andre
config=~/.config/chimera
cloud_init="$(dirname "$0")/../cloud-init.yaml"
image_init="$(dirname "$0")/../image.yaml"

server_status() {
  hcloud server list -o json | jq -r --arg n "$name" '(. // [])[] | select(.name == $n) | .status'
}

ssh_answers() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 -o ProxyCommand=none "$user@$name" true 2>/dev/null
}

control() {
  local method=$1 path=$2 url
  shift 2
  url=$(cat "$config/wake-url")
  printf 'Authorization: Bearer %s\n' "$(tr -d '\n' < "$config/wake-token")" \
    | curl -fsS --max-time 10 -X "$method" -H @- "$@" "${url%/wake}$path"
}

want() { control POST /want --max-time 5 -d "$1" >/dev/null 2>&1 || true; }

plural() { if [ "$1" = 1 ]; then echo "$1 $2"; else echo "$1 ${2}s"; fi; }

ago() {
  if [ "$1" -lt 60 ]; then echo "$(plural "$1" second) ago"
  elif [ "$1" -lt 3600 ]; then echo "$(($1 / 60)) min ago"
  else echo "$(plural $(($1 / 3600)) hour) ago"; fi
}

read_state() {
  control GET /state 2>/dev/null || { echo "Couldn't reach the Worker." >&2; exit 1; }
}

report_age() {
  local seconds
  seconds=$(jq -r '.reportAgeSeconds // empty' <<<"$1")
  if [ -n "$seconds" ]; then echo "Last report $(ago "$seconds")."; else echo "No report yet."; fi
}

cmd_status() {
  local info
  info=$(read_state)
  if jq -e '.server != null and .server.firewalls == 0' <<<"$info" >/dev/null; then
    echo "Warning: public SSH is open. Close it with: hcloud firewall apply-to-resource $firewall --type server --server $name" >&2
  fi
  jq -r .state <<<"$info"
  echo "$(report_age "$info")$(jq -r 'if .busy == true then " An agent was working." else "" end' <<<"$info")"
}

work_notes() {
  local w=$1 who count
  who=$(jq -r .name <<<"$w")
  count=$(jq '.work.unpushed | length' <<<"$w")
  if [ "$count" != 0 ]; then
    echo "$who: $(plural "$count" commit) not on GitHub"
    jq -r '.work.unpushed[] | "  " + .' <<<"$w"
  fi
  count=$(jq '.work.uncommitted | length' <<<"$w")
  if [ "$count" != 0 ]; then
    echo "$who: $(plural "$count" "uncommitted file")"
    jq -r '.work.uncommitted[] | "  " + .' <<<"$w"
  fi
  if jq -e '.work.error != null' <<<"$w" >/dev/null; then echo "$who: $(jq -r .work.error <<<"$w")"; fi
}

cmd_ls() {
  [ $# -eq 0 ] || { echo "usage: chimera ls" >&2; exit 2; }
  local info w notes seconds checked
  info=$(read_state)
  echo "Computer $(jq -r .state <<<"$info"). $(report_age "$info")"
  if jq -e '.workspaces | length == 0' <<<"$info" >/dev/null; then echo "No containers."; return; fi
  jq -r '(["NAME", "STATE", "FROM", "TASK", "REPO", "BRANCH"] | @tsv),
    (.workspaces[] | [.name, .state, .parent // "-", .task // "-", .repo // "-", .branch // "-"] | @tsv)' <<<"$info" \
    | column -t -s $'\t'
  seconds=$(jq -r '.reportAgeSeconds // empty' <<<"$info")
  while IFS= read -r w; do
    notes=$(work_notes "$w")
    [ -n "$notes" ] || continue
    echo
    echo "$notes"
    checked=$(jq -r '.work.checkAgeSeconds // empty' <<<"$w")
    if [ -n "$checked" ] && [ -n "$seconds" ] && [ "$checked" -gt "$seconds" ]; then echo "(checked $(ago "$checked"))"; fi
  done < <(jq -c '.workspaces[] | select(.work != null)' <<<"$info")
}

cmd_sleep() {
  local status
  want asleep
  status=$(server_status)
  if [ "$status" = running ]; then
    hcloud server shutdown "$name"
    echo "Backing up before sleep..."
  fi
  for _ in $(seq 360); do
    status=$(server_status)
    case "$status" in
      "") echo asleep; return ;;
      off) hcloud server delete "$name" || true ;;
    esac
    sleep 2
  done
  echo "The server didn't shut down within 12 minutes. Run 'chimera sleep' again, or force it off with 'hcloud server poweroff $name'." >&2
  exit 1
}

newest_image() {
  hcloud image list --type snapshot --selector "$image_label" --sort created:desc -o json \
    | jq -r '[(. // [])[] | select(.status == "available")][0].id // empty'
}

create_server() {
  local image
  image=$(newest_image)
  [ -n "$image" ] || { echo "There's no chimera image yet. Build one with 'chimera build-image'." >&2; exit 1; }
  hcloud server create --name "$name" --type "$server_type" --image "$image" \
    --location "$location" --ssh-key "$ssh_key" --primary-ipv4 "$primary_ip" \
    "${volumes[@]/#/--volume=}" --user-data-from-file "$@"
}

cmd_wake() {
  local deadline=$((SECONDS + 900)) waiting=
  while [ "$SECONDS" -lt "$deadline" ]; do
    case "$(server_status)" in
      "") create_server "$cloud_init" --firewall "$firewall" ;;
      off) hcloud server delete "$name" || true ;;
      running) ssh_answers && { want awake; echo awake; return; } ;;
    esac
    [ -n "$waiting" ] || { echo "Waiting for SSH on $name over Tailscale..."; waiting=1; }
    sleep 3
  done
  echo "SSH didn't answer within 15 minutes. Run 'chimera status' to see what it's doing." >&2
  exit 1
}

cmd_connect() {
  if ! nc -z -G 2 "$name" 22 2>/dev/null; then
    echo "Waking $name..." >&2
    cmd_wake </dev/null >&2
  fi
  exec nc "$name" 22
}

push_backup_keys() {
  local dir=/home/.chimera/backup
  "$@" "sudo install -d -m 700 $dir && sudo sh -c 'umask 077 && cat > $dir/env'" < "$config/backup.env"
  "$@" "sudo sh -c 'umask 077 && cat > $dir/password'" < "$config/backup-password"
  "$@" "sudo chimera-restic cat config >/dev/null 2>&1 || sudo chimera-restic init"
}

cmd_backup_keys() {
  push_backup_keys ssh "$user@$name"
  echo "backup keys are on the volume"
}

cmd_agent_key() {
  local file=$config/agent-token
  if [ ! -e "$file" ]; then
    mkdir -p "$config"
    (umask 077 && printf '%s' "$(openssl rand -hex 32)" > "$file")
  fi
  ssh "$user@$name" "sudo sh -c 'umask 077 && cat > /home/.chimera/agent-token'" < "$file"
  echo "Now run in control/: npx wrangler secret put AGENT_TOKEN < ~/.config/chimera/agent-token"
}

close_public_ssh() {
  echo "Closing public SSH..."
  hcloud firewall apply-to-resource "$firewall" --type server --server "$name" >/dev/null && return
  echo "PUBLIC SSH IS STILL OPEN. Close it with: hcloud firewall apply-to-resource $firewall --type server --server $name" >&2
  return 1
}

cmd_restore() {
  [ -z "$(server_status)" ] || { echo "Put the computer to sleep first with 'chimera sleep'. Restore wakes it itself." >&2; exit 1; }
  tmp=$(mktemp -d)
  trap 'close_public_ssh; rm -rf "$tmp"' EXIT

  # A throwaway host key, given to the new server, lets us check we're talking to it before sending secrets.
  ssh-keygen -q -t ed25519 -N '' -C chimera-restore -f "$tmp/host"
  {
    cat "$cloud_init"
    echo "ssh_keys:"
    echo "  ed25519_private: |"
    sed 's/^/    /' "$tmp/host"
    echo "  ed25519_public: $(cat "$tmp/host.pub")"
  } > "$tmp/user-data"

  echo "Waking with public SSH open..."
  create_server "$tmp/user-data"
  local ip
  ip=$(hcloud server ip "$name")
  echo "$ip $(cut -d' ' -f1,2 "$tmp/host.pub")" > "$tmp/known_hosts"
  local public=(ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=yes
    -o UserKnownHostsFile="$tmp/known_hosts" -o HostKeyAlgorithms=ssh-ed25519 "$user@$ip")
  for _ in $(seq 60); do "${public[@]}" true 2>/dev/null && break; sleep 3; done
  "${public[@]}" "cloud-init status --wait >/dev/null" || { echo "Couldn't reach the computer at $ip, or its setup failed." >&2; exit 1; }

  if "${public[@]}" "test -e /home/.chimera/backup/env || tailscale status >/dev/null 2>&1"; then
    echo "This disk isn't blank (it has backup keys or a Tailscale login). Not restoring over it." >&2
    trap 'rm -rf "$tmp"' EXIT
    close_public_ssh || true
    cmd_sleep
    exit 1
  fi

  echo "Copying backup keys..."
  push_backup_keys "${public[@]}"
  echo "Restoring /home from the latest backup..."
  "${public[@]}" "sudo systemctl stop docker.socket docker containerd tailscaled incus-startup incus incus.socket incus-user.socket && sudo chimera-restic restore latest --target / --exclude /home/.chimera/docker/volumes/backingFsBlockDev"
  echo "Restarting so it picks up its old Tailscale login and SSH fingerprint..."
  "${public[@]}" "sudo systemctl reboot" || true
  sleep 15

  trap 'rm -rf "$tmp"' EXIT
  close_public_ssh || exit 1
  echo "Waiting for $user@$name over Tailscale..."
  for _ in $(seq 60); do
    if ssh_answers; then echo "restored"; return; fi
    sleep 5
  done
  echo "The computer didn't come back over Tailscale within 5 minutes. Run 'ssh $user@$name' to see the error." >&2
  exit 1
}

cmd_build_image() {
  local build=chimera-image-build before
  before=$(newest_image)
  if [ -z "$(hcloud server list -o json | jq -r --arg n "$build" '(. // [])[] | select(.name == $n) | .name')" ]; then
    hcloud server create --name "$build" --type "$server_type" --image "$base_image" --location "$location" \
      --ssh-key "$ssh_key" --firewall "$firewall" --user-data-from-file "$image_init" >/dev/null
  fi
  echo "Building. The Worker saves the image once the build server powers off, usually within 10 minutes..."
  for _ in $(seq 120); do
    if [ "$(newest_image)" != "$before" ]; then echo "Image ready. The next wake uses it."; return; fi
    sleep 10
  done
  echo "No new image after 20 minutes. Check the Worker's logs with 'npx wrangler tail' in control/." >&2
  exit 1
}

cmd_forward() {
  ssh_answers || cmd_wake >&2
  local tty=-T
  if [ -t 0 ] && [ -t 1 ]; then tty=-t; fi
  exec ssh "$tty" -o ProxyCommand=none "$user@$name" chimera "$(printf '%q ' "$@")"
}

case "${1:-}" in
  sleep) cmd_sleep ;;
  wake) cmd_wake ;;
  connect) cmd_connect ;;
  status) cmd_status ;;
  backup-keys) cmd_backup_keys ;;
  agent-key) cmd_agent_key ;;
  restore) cmd_restore ;;
  build-image) cmd_build_image ;;
  ls) shift; cmd_ls "$@" ;;
  new|fork|results|run|shell|rm|secret|base) cmd_forward "$@" ;;
  *) echo "usage: chimera sleep|wake|connect|status|backup-keys|agent-key|restore|build-image|new|fork|ls|results|run|shell|rm|secret|base" >&2; exit 2 ;;
esac
