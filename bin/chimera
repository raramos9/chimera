#!/usr/bin/env bash
set -euo pipefail

name=chimera
server_type=cpx11
location=hil
image=ubuntu-24.04
ssh_key=laptop
primary_ip=chimera-ip
firewall=chimera-firewall
volume=chimera-home
user=andre
cloud_init="$(dirname "$0")/../cloud-init.yaml"

server_status() {
  hcloud server list -o json | jq -r --arg n "$name" '(. // [])[] | select(.name == $n) | .status'
}

ssh_answers() {
  ssh -o BatchMode=yes -o ConnectTimeout=5 "$user@$name" true 2>/dev/null
}

cmd_status() {
  local status
  status=$(server_status)
  case "$status" in
    "") echo asleep ;;
    running) if ssh_answers; then echo awake; else echo waking; fi ;;
    initializing|starting) echo waking ;;
    stopping|off|deleting) echo going-to-sleep ;;
    *) echo "unknown ($status)" ;;
  esac
}

cmd_sleep() {
  local status
  status=$(server_status)
  if [ "$status" = running ]; then
    hcloud server shutdown "$name"
  fi
  for _ in $(seq 60); do
    status=$(server_status)
    case "$status" in
      "") echo asleep; return ;;
      off) hcloud server delete "$name" || true ;;
    esac
    sleep 2
  done
  echo "The server didn't shut down within 2 minutes. Run 'chimera sleep' again, or force it off with 'hcloud server poweroff $name'." >&2
  exit 1
}

cmd_wake() {
  local status
  status=$(server_status)
  if [ "$status" = off ]; then
    hcloud server delete "$name" || true
    status=$(server_status)
  fi
  case "$status" in
    "")
      hcloud server create --name "$name" --type "$server_type" --image "$image" \
        --location "$location" --ssh-key "$ssh_key" --primary-ipv4 "$primary_ip" --firewall "$firewall" \
        --volume "$volume" --user-data-from-file "$cloud_init"
      ;;
    stopping|deleting)
      echo "The computer is still going to sleep. Run 'chimera wake' again in a minute." >&2
      exit 1
      ;;
  esac
  echo "Waiting for SSH on $name over Tailscale..."
  for _ in $(seq 60); do
    if ssh_answers; then echo awake; return; fi
    sleep 3
  done
  echo "SSH didn't answer within 3 minutes. Run 'ssh $user@$name' to see the error." >&2
  exit 1
}

cmd_backup_keys() {
  local config=~/.config/chimera dir=/home/.chimera/backup
  ssh "$user@$name" "sudo install -d -m 700 $dir && sudo sh -c 'umask 077 && cat > $dir/env'" < "$config/backup.env"
  ssh "$user@$name" "sudo sh -c 'umask 077 && cat > $dir/password'" < "$config/backup-password"
  ssh "$user@$name" "sudo chimera-restic cat config >/dev/null 2>&1 || sudo chimera-restic init"
  echo "backup keys are on the volume"
}

case "${1:-}" in
  sleep) cmd_sleep ;;
  wake) cmd_wake ;;
  status) cmd_status ;;
  backup-keys) cmd_backup_keys ;;
  *) echo "usage: chimera sleep|wake|status|backup-keys" >&2; exit 2 ;;
esac
